{%- comment -%} Le thermostat au défilement. Params : s, c_frais, c_calme, c_chaud, u_frais, u_calme, u_chaud. Sans JS : une scène fixe, les trois univers restent accessibles par les liens du bas. {%- endcomment -%}
<section class="lc-th" id="lc-univers" aria-labelledby="lc-th-title" data-lc-th>
  <div class="lc-th__stage">
    <div class="lc-th__media" aria-hidden="true">
      {%- for n in (1..3) -%}
        {%- liquid
          case n
            when 1
              assign img = s.frais_image
            when 2
              assign img = s.calme_image
            else
              assign img = s.chaud_image
          endcase
        -%}
        <div class="lc-th__img" data-lc-th-img>{%- if img -%}{{ img | image_url: width: 2400 | image_tag: widths: '750,1100,1500,2000,2400', sizes: '100vw', loading: 'lazy', alt: '' }}{%- endif -%}</div>
      {%- endfor -%}
      <div class="lc-th__cool"></div><div class="lc-th__warm"></div><div class="lc-th__shade"></div>
    </div>

    <div class="lc-th__intro">
      <h2 id="lc-th-title">Faites défiler, <em>la maison change de température.</em></h2>
    </div>
    <p class="lc-th__deg" aria-hidden="true"><span data-lc-th-num>18</span><sup>°</sup></p>

    <div class="lc-th__panels">
      {%- for n in (1..3) -%}
        {%- liquid
          case n
            when 1
              assign col = c_frais
              assign href = u_frais
              assign t = 'Au frais'
              assign d = 'Dormir sans transpirer, travailler sans étouffer. Ventilateurs silencieux, rafraîchisseurs d’air, couvertures et oreillers qui restent frais toute la nuit.'
            when 2
              assign col = c_calme
              assign href = u_calme
              assign t = 'Au calme'
              assign d = 'Le sommeil et le bien-être. Couvertures lestées, oreillers ergonomiques, soutien du dos, massage et méditation, pour ralentir le soir et se lever reposé.'
            else
              assign col = c_chaud
              assign href = u_chaud
              assign t = 'Au chaud'
              assign d = 'Le confort des soirs d’hiver. Plaids, coussins chauffants, théières en fonte et en verre, tisanes. De quoi rester dans le canapé un peu plus longtemps.'
          endcase
        -%}
        <div class="lc-th__panel{% if n == 1 %} is-on{% endif %}" data-lc-th-panel>
          {%- if col.products_count > 0 -%}<p class="lc-th__count">{{ col.products_count }} objets</p>{%- endif -%}
          <h3>{{ t }}</h3>
          <p>{{ d }}</p>
          <a class="lc-btn lc-btn--light" href="{{ href }}">Explorer {{ t | downcase }}</a>
        </div>
      {%- endfor -%}
    </div>

    <div class="lc-th__rule">
      <div class="lc-th__bar" aria-hidden="true"><span class="lc-th__dot"></span></div>
      <nav class="lc-th__stops" aria-label="Univers">
        <a href="{{ u_frais }}" class="is-on" data-lc-th-stop><b>Au frais</b>18° · nuits d’été</a>
        <a href="{{ u_calme }}" data-lc-th-stop><b>Au calme</b>21° · sommeil et bien-être</a>
        <a href="{{ u_chaud }}" data-lc-th-stop><b>Au chaud</b>26° · cocon d’hiver</a>
      </nav>
    </div>
  </div>
</section>
