{%- liquid
  assign s = section.settings
  assign c_frais = collections['au-frais']
  assign c_chaud = collections['au-chaud']
  assign c_calme = collections['au-calme']
  assign u_frais = c_frais.url | default: '/collections/au-frais'
  assign u_chaud = c_chaud.url | default: '/collections/au-chaud'
  assign u_calme = c_calme.url | default: '/collections/au-calme'
  assign cats = 'boutique-de-noel|plaids-housses-cosy|theieres|tisanes|sommeil|massage|yoga|acupression|idees-cadeaux-originales-objets-deco' | split: '|'
  assign cat_names = 'Boutique de Noël|Plaids & couvertures|Théières & infuseurs|Thés & tisanes|Sommeil|Massage & détente|Yoga|Acupression|Idées cadeaux' | split: '|'
  assign vedette = s.vedette | default: s.heroes.first
  assign u_noel = collections['boutique-de-noel'].url | default: '/collections/boutique-de-noel'
-%}
<div class="lc lc4" id="lc-top" data-temp="chaud">
<script>document.getElementById('lc-top').classList.add('lc-js');</script>
{%- render 'lc4-header', u_frais: u_frais, u_chaud: u_chaud, u_calme: u_calme -%}

<section class="lc4-hero lc-wrap" aria-labelledby="lc4-title">
  <div class="lc4-hero__text">
    <h1 id="lc4-title" class="lc4-hero__title">Bien au chaud, <em>dès la tombée du jour.</em></h1>
    <p class="lc4-hero__lead">Plaids et couvertures lestées, théières de fonte, tisanes du soir, coussins chauffants. Plus de 1&nbsp;700 objets pour passer l’hiver au chaud&nbsp;— et de quoi l’offrir.</p>
    <div class="lc4-hero__ctas">
      <a class="lc-btn lc4-btn--dark" href="{{ u_noel }}">Les cadeaux de fin d’année</a>
      <a class="lc-btn lc4-btn--line" href="#lc4-rayons">Parcourir les rayons</a>
    </div>
  </div>

  <div class="lc4-thermo">
    {%- if vedette != blank -%}
      <div class="lc4-stage">
        <a class="lc4-stage__media" href="{{ vedette.url }}" tabindex="-1" aria-hidden="true">
          {%- if vedette.featured_media -%}{{ vedette.featured_media | image_url: width: 1264 | image_tag: widths: '600,800,1000,1264', sizes: '(min-width: 1000px) 560px, 92vw', loading: 'eager', fetchpriority: 'high', alt: '' }}{%- endif -%}
        </a>
        <div class="lc4-stage__info">
          <div>
            <p class="lc4-stage__note">L’objet de la saison</p>
            {%- render 'lc4-rating', p: vedette -%}
            <a class="lc4-stage__title" href="{{ vedette.url }}">{{ vedette.title | split: ' – ' | first }}</a>
          </div>
          <div class="lc4-stage__buy">
            <span class="lc4-stage__price">{% if vedette.price_varies %}<small>dès </small>{% endif %}{{ vedette.price | money }}</span>
            {%- if vedette.available and vedette.has_only_default_variant -%}
              <form method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" value="{{ vedette.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button type="submit" class="lc-btn lc4-btn--dark">Ajouter au panier</button></form>
            {%- else -%}
              <a class="lc-btn lc4-btn--dark" href="{{ vedette.url }}">Voir le produit</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<section class="lc-wrap lc4-rayons" id="lc4-rayons" aria-labelledby="lc4-rayons-title">
  <h2 class="lc4-h3" id="lc4-rayons-title">Les rayons du Comptoir</h2>
  <ul class="lc4-rayons__grid">
    {%- for h in cats -%}
      {%- assign col = collections[h] -%}
      {%- assign vis = col.image | default: col.products.first.featured_media.preview_image -%}
      <li>
        <a class="lc4-rayon" href="/collections/{{ h }}">
          <span class="lc4-rayon__media">
            {%- if vis -%}{{ vis | image_url: width: 800 | image_tag: widths: '400,600,800', sizes: '(min-width: 1000px) 300px, 46vw', loading: 'lazy', alt: '' }}{%- endif -%}
          </span>
          <span class="lc4-rayon__body">
            <span class="lc4-rayon__name">{{ cat_names[forloop.index0] }}</span>
            {%- if col.products_count > 0 -%}<small>{{ col.products_count }} objets</small>{%- endif -%}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

<section class="lc-wrap lc4-block" id="lc4-ventes" aria-labelledby="lc4-ventes-title">
  <div class="lc4-head">
    <h2 class="lc-h2" id="lc4-ventes-title">Les plus <em>vendus.</em></h2>
    <a class="lc4-more" href="{{ routes.all_products_collection_url }}">Tout le catalogue</a>
  </div>
  <div class="lc4-grid lc4-grid--4">
    {%- for p in s.bestsellers -%}{%- render 'lc4-pcard', product: p, sizes: '(min-width: 1000px) 320px, 46vw' -%}{%- endfor -%}
  </div>
</section>

<section class="lc-wrap lc4-block lc4-proof" id="lc4-avis" aria-labelledby="lc4-avis-title">
  <div class="lc4-head">
    <div>
      <h2 class="lc-h2" id="lc4-avis-title">Ce qu’en disent <em>nos clients.</em></h2>
      <p class="lc4-sub">Les avis recueillis par la Société des Avis Garantis, organisme indépendant, et ceux laissés sur nos fiches produits.</p>
    </div>
    <div class="lc4-proof__rating"><div class="grc-site-rating"></div></div>
  </div>
  <div class="lc4-proof__jdgm">{% for block in section.blocks %}{% render block %}{% endfor %}</div>
</section>

<section class="lc4-band lc4-band--the" aria-labelledby="lc4-the-title">
  <div class="lc-wrap">
    <div class="lc4-head">
      <div>
        <h2 class="lc-h2" id="lc4-the-title">L’heure du <em>thé.</em></h2>
        <p class="lc4-sub">Fonte, verre borosilicate, infuseurs intégrés. Pour les après-midi d’hiver côté fenêtre.</p>
      </div>
      <a class="lc4-more" href="/collections/theieres">Toutes les théières</a>
    </div>
    <div class="lc4-grid lc4-grid--5">
      {%- for p in s.the_products -%}{%- render 'lc4-pcard', product: p, sizes: '(min-width: 1000px) 250px, 46vw' -%}{%- endfor -%}
    </div>
  </div>
</section>

<section class="lc-wrap lc4-block" aria-labelledby="lc4-dos-title">
  <div class="lc4-head">
    <div>
      <h2 class="lc-h2" id="lc4-dos-title">Bien assis, <em>bien dormi.</em></h2>
      <p class="lc4-sub">Mousse à mémoire de forme, soutien de la nuque et du dos, assise pour méditer.</p>
    </div>
    <a class="lc4-more" href="/collections/sommeil">Tout le rayon sommeil</a>
  </div>
  <div class="lc4-grid lc4-grid--5">
    {%- for p in s.dos_products -%}{%- render 'lc4-pcard', product: p, sizes: '(min-width: 1000px) 250px, 46vw' -%}{%- endfor -%}
  </div>
</section>

<section class="lc-wrap lc4-block" id="lc4-noel" aria-labelledby="lc4-noel-title">
  <div class="lc4-head">
    <div>
      <h2 class="lc-h2" id="lc4-noel-title">Idées cadeaux de <em>fin d’année.</em></h2>
      <p class="lc4-sub">Des cadeaux prêts à offrir, choisis pour être reçus avec plaisir.</p>
    </div>
    <a class="lc4-more" href="/collections/boutique-de-noel">Toute la sélection</a>
  </div>
  {%- assign noel = collections['boutique-de-noel'] -%}
  {%- assign shown = 0 -%}
  <div class="lc4-grid lc4-grid--4">
    {%- for p in noel.products limit: 16 -%}
      {%- if p.available and shown < 4 and p.featured_media -%}{%- render 'lc4-pcard', product: p, sizes: '(min-width: 1000px) 300px, 46vw' -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
  </div>
</section>

<section class="lc4-band lc4-band--yoga" id="lc4-yoga" aria-labelledby="lc4-yoga-title">
  <div class="lc-wrap">
    <div class="lc4-head">
      <div>
        <h2 class="lc-h2" id="lc4-yoga-title">Yoga & <em>acupression.</em></h2>
        <p class="lc4-sub">Tapis, coussins et accessoires pour pratiquer chez soi, et points de pression pour les tensions du quotidien.</p>
      </div>
      <a class="lc4-more" href="/collections/yoga">Tout le yoga</a>
    </div>
    {%- assign yoga = collections['yoga'] -%}
    {%- assign shown = 0 -%}
    <div class="lc4-grid lc4-grid--5">
      {%- for p in yoga.products limit: 16 -%}
        {%- if p.available and shown < 5 and p.featured_media -%}{%- render 'lc4-pcard', product: p, sizes: '(min-width: 1000px) 250px, 46vw' -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="lc-wrap lc4-block" id="lc4-cocon" aria-labelledby="lc4-cocon-title">
  <div class="lc4-head">
    <div>
      <h2 class="lc-h2" id="lc4-cocon-title">Cocooning <em>d’hiver.</em></h2>
      <p class="lc4-sub">Plaids, coussins chauffants, théières et tisanes pour les soirées qui raccourcissent.</p>
    </div>
    <a class="lc4-more" href="/collections/selection-automne-hiver">Toute la sélection hiver</a>
  </div>
  {%- assign cocon = collections['selection-automne-hiver'] -%}
  {%- assign shown = 0 -%}
  <div class="lc4-grid lc4-grid--4">
    {%- for p in cocon.products limit: 16 -%}
      {%- if p.available and shown < 4 and p.featured_media -%}{%- render 'lc4-pcard', product: p, sizes: '(min-width: 1000px) 300px, 46vw' -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- render 'lc-bottom', s: s, hide_dehors: true -%}
</div>

{% schema %}
{
  "name": "Comptoir v4 Vitrine",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "vedette", "label": "Produit mis en scène en haut de page" },
    { "type": "product_list", "id": "bestsellers", "label": "Les plus vendus", "limit": 8 },
    { "type": "product_list", "id": "the_products", "label": "L'heure du thé", "limit": 10 },
    { "type": "product_list", "id": "dos_products", "label": "Bien assis, bien dormi", "limit": 10 }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Comptoir v4 Vitrine" }]
}
{% endschema %}
