{%- comment -%} Bandeau + navigation LE COMPTOIR. Params : u_frais, u_chaud, u_calme {%- endcomment -%}
<p class="lc4-annonce"><span>Livraison offerte dès 69&nbsp;€ en point relais en France</span><span>Livrée en 3 à 8 jours selon l’article</span><span>Retours sous 14 jours</span><span>Paiement en 3 fois avec Klarna</span></p>

<header class="lc-nav is-solid" data-lc-nav>
  <a class="lc-logo" href="{{ routes.root_url }}" aria-label="Le Comptoir, accueil">
    <svg width="26" height="30" viewBox="0 0 30 34" aria-hidden="true"><path d="M2 33V15a13 13 0 0 1 26 0v18" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 26a7 7 0 0 1 14 0" fill="#B4471F"/><line x1="2" y1="26" x2="28" y2="26" stroke="currentColor" stroke-width="1.8"/></svg>
    <span>LE COMPTOIR</span>
  </a>
  <nav class="lc-links" aria-label="Univers">
    <a href="{{ collections['boutique-de-noel'].url | default: '/collections/boutique-de-noel' }}">Noël</a><a href="{{ u_chaud }}">Au chaud</a><a href="{{ u_calme }}">Au calme</a><a href="{{ collections['plaids-housses-cosy'].url | default: '/collections/plaids-housses-cosy' }}">Cocooning</a><a href="{{ routes.all_products_collection_url }}">Tout le Comptoir</a>
  </nav>
  <div class="lc-actions">
    <form class="lc4-search" action="{{ routes.search_url }}" method="get" role="search"><label for="lc4-q" class="lc-sr">Rechercher un produit</label><input id="lc4-q" type="search" name="q" placeholder="Théière, plaid, couverture lestée…" autocomplete="off"><input type="hidden" name="type" value="product"><button type="submit" aria-label="Lancer la recherche"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.4"/><line x1="11" y1="11" x2="15" y2="15" stroke="currentColor" stroke-width="1.4"/></svg></button></form>
    <a class="lc-icon lc4-search-icon" href="{{ routes.search_url }}" aria-label="Rechercher"><svg width="17" height="17" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.4"/><line x1="11" y1="11" x2="15" y2="15" stroke="currentColor" stroke-width="1.4"/></svg></a>
    <a class="lc-icon lc-hide-sm" href="{{ routes.account_url }}" aria-label="Mon compte"><svg width="17" height="17" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="5" r="3.2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M1.8 15c.8-3.2 3.3-5 6.2-5s5.4 1.8 6.2 5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></a>
    <a class="lc-cart" href="{{ routes.cart_url }}">Panier <span>{{ cart.item_count }}</span></a>
    <details class="lc-menu">
      <summary aria-label="Menu"><span></span><span></span></summary>
      <div class="lc-menu__sheet">
        <a href="{{ collections['boutique-de-noel'].url | default: '/collections/boutique-de-noel' }}">Noël</a><a href="{{ u_chaud }}">Au chaud</a><a href="{{ u_calme }}">Au calme</a><a href="{{ collections['plaids-housses-cosy'].url | default: '/collections/plaids-housses-cosy' }}">Cocooning</a><a href="{{ routes.all_products_collection_url }}">Tout le Comptoir</a><a href="{{ routes.account_url }}">Mon compte</a>
      </div>
    </details>
  </div>
</header>
